<Window x:Class="Awake.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Awake.App"
        Title="KeepMyMacAwake · Windows" Icon="assets/app.ico" Width="480" MinWidth="460" MinHeight="300" SizeToContent="Height"
        Background="{DynamicResource PageBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13"
        UseLayoutRounding="True" WindowStartupLocation="CenterScreen" Closing="WindowClosing">
  <Window.Resources>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Setter Property="Padding" Value="12,5" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
        <Border x:Name="TabSurface" Padding="{TemplateBinding Padding}" CornerRadius="14" Background="Transparent" BorderBrush="Transparent" BorderThickness="0.5">
          <ContentPresenter x:Name="TabHeader" ContentSource="Header" RecognizesAccessKey="True" TextElement.FontWeight="Normal" />
        </Border>
        <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True">
          <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource RaisedBrush}" /><Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource LineBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter TargetName="TabHeader" Property="TextElement.FontWeight" Value="SemiBold" />
        </Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Window.InputBindings><KeyBinding Key="Enter" Modifiers="Control" Command="{Binding ToggleCommand}" /></Window.InputBindings>
  <Grid Margin="22,16,22,0">
    <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <TabControl x:Name="Pages" Background="Transparent" BorderThickness="0">
      <TabControl.Template><ControlTemplate TargetType="TabControl">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
          <Border HorizontalAlignment="Right" Background="{DynamicResource WellBrush}" CornerRadius="16" Padding="2" Margin="0,0,0,16">
            <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="0" />
          </Border>
          <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" />
        </Grid>
      </ControlTemplate></TabControl.Template>
      <TabItem Header="控制">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="{DynamicResource ContentMaxHeight}">
          <StackPanel Margin="0,0,0,20">
            <local:SessionHero />
            <StackPanel x:Name="Configuration" Margin="0,16,0,0" Visibility="{Binding ShowConfiguration, Converter={StaticResource BoolVisibility}}">
              <TextBlock Text="场景" Style="{StaticResource SectionTitle}" />
              <UniformGrid Columns="2" Rows="2" Margin="-4,0,-4,12">
                <Button Content="日常" Command="{Binding DailyCommand}" Style="{StaticResource SceneButton}" Tag="{Binding IsDailyScene}" Margin="4,0,4,8" ToolTip="1 小时，需开盖，仅接电，屏幕自动关闭" />
                <Button Content="夜间" Command="{Binding NightCommand}" Style="{StaticResource SceneButton}" Tag="{Binding IsNightScene}" Margin="4,0,4,8" ToolTip="8 小时，需开盖，仅接电，屏幕调暗" />
                <Button Content="接电合盖" Command="{Binding LidCommand}" Style="{StaticResource SceneButton}" Tag="{Binding IsLidScene}" Margin="4,0,4,4" ToolTip="不限时；Windows 预览尚未开放合盖" />
                <Button Content="外出合盖" Command="{Binding NetworkCommand}" Style="{StaticResource SceneButton}" Tag="{Binding IsNetworkScene}" Margin="4,0,4,4" ToolTip="2 小时，断网即停；Windows 预览尚未开放合盖与电池" />
              </UniformGrid>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="选项" Style="{StaticResource SectionTitle}" />
                <Border Background="{DynamicResource WellBrush}" CornerRadius="8" Padding="6,1" Margin="8,0,0,8" Visibility="{Binding IsCustomized, Converter={StaticResource BoolVisibility}}">
                  <TextBlock Text="已调整" FontSize="10" Foreground="{DynamicResource MutedBrush}" />
                </Border>
              </StackPanel>
              <Border Style="{StaticResource Card}">
                <StackPanel IsEnabled="{Binding CanEdit}">
                  <DockPanel><TextBlock Text="时长" VerticalAlignment="Center" /><ComboBox DockPanel.Dock="Right" HorizontalAlignment="Right" MinWidth="130" ItemsSource="{Binding Durations}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding DurationMinutes}" AutomationProperties.Name="时长" /></DockPanel>
                  <DockPanel Margin="0,8,0,0" Visibility="{Binding IsCustomDuration, Converter={StaticResource BoolVisibility}}">
                    <TextBlock Text="分钟" VerticalAlignment="Center" /><TextBox HorizontalAlignment="Right" Width="80" Text="{Binding CustomMinutesText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="自定义分钟" ToolTip="1–1440 分钟" />
                  </DockPanel>
                  <Separator />
                  <DockPanel>
                    <TextBlock Text="屏幕" VerticalAlignment="Center" />
                    <Border HorizontalAlignment="Right" Background="{DynamicResource WellBrush}" CornerRadius="16" Padding="2" ToolTip="自动关闭：按系统设置关闭屏幕&#10;常亮：屏幕保持点亮&#10;调暗：软件暗色遮罩，不调节硬件亮度；锁屏时撤下，解锁后恢复">
                      <StackPanel Orientation="Horizontal">
                        <RadioButton Content="自动关闭" GroupName="Screen" Style="{StaticResource Pill}" IsChecked="{Binding IsAutomaticScreen}" FontSize="11.5" />
                        <RadioButton Content="常亮" GroupName="Screen" Style="{StaticResource Pill}" IsChecked="{Binding IsAlwaysOnScreen}" FontSize="11.5" />
                        <RadioButton Content="调暗" GroupName="Screen" Style="{StaticResource Pill}" IsChecked="{Binding IsNightDim}" FontSize="11.5" />
                      </StackPanel>
                    </Border>
                  </DockPanel>
                  <DockPanel Margin="0,8,0,0" Visibility="{Binding IsNightDim, Converter={StaticResource BoolVisibility}}">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding DimText}" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    <Slider Minimum="0.8" Maximum="0.98" Value="{Binding DimAmount}" Foreground="{DynamicResource AccentBrush}" AutomationProperties.Name="调暗程度" ToolTip="按 Esc 或点击停止撤销调暗遮罩" />
                  </DockPanel>
                  <Separator />
                  <CheckBox Content="合盖后继续运行" IsChecked="{Binding LidMode}" ToolTip="关闭时，合盖会正常睡眠" />
                  <Border Background="{DynamicResource WellBrush}" CornerRadius="10" Padding="12" Margin="0,4,0,6" Visibility="{Binding LidMode, Converter={StaticResource BoolVisibility}}">
                    <TextBlock Text="Windows 预览尚未开放合盖。请选择日常或夜间，或关闭此选项后接电、开盖使用。" FontSize="11" Foreground="{DynamicResource WarningBrush}" />
                  </Border>
                  <CheckBox Content="仅在接通电源时运行" IsChecked="{Binding RequireAC}" />
                  <Border Background="{DynamicResource WellBrush}" CornerRadius="10" Padding="12" Margin="0,4,0,6">
                    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding RequireAC}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                    <TextBlock Text="Windows 预览尚未开放电池使用，请打开“仅在接通电源时运行”。" FontSize="11" Foreground="{DynamicResource WarningBrush}" />
                  </Border>
                  <CheckBox Content="断网时停止" IsChecked="{Binding RequireNetwork}" ToolTip="只检测系统是否有可用网络；网络恢复后不会自动开始" />
                </StackPanel>
              </Border>
            </StackPanel>
            <StackPanel x:Name="SessionSummary" Margin="0,16,0,0" Visibility="{Binding IsActive, Converter={StaticResource BoolVisibility}}">
              <TextBlock Text="本次会话" Style="{StaticResource SectionTitle}" />
              <Border Style="{StaticResource Card}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                  <TextBlock Text="场景" Foreground="{DynamicResource MutedBrush}" /><TextBlock Grid.Column="1" Text="{Binding SceneStatusText}" HorizontalAlignment="Right" />
                  <TextBlock Grid.Row="1" Text="开始" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding StartedText}" HorizontalAlignment="Right" Margin="0,8,0,0" />
                  <TextBlock Grid.Row="2" Text="屏幕" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ScreenText}" HorizontalAlignment="Right" Margin="0,8,0,0" />
                  <TextBlock Grid.Row="3" Text="供电" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PowerRuleText}" HorizontalAlignment="Right" Margin="0,8,0,0" />
                  <TextBlock Grid.Row="4" Text="断网" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" Visibility="{Binding RequireNetwork, Converter={StaticResource BoolVisibility}}" /><TextBlock Grid.Row="4" Grid.Column="1" Text="停止" HorizontalAlignment="Right" Margin="0,8,0,0" Visibility="{Binding RequireNetwork, Converter={StaticResource BoolVisibility}}" />
                </Grid>
              </Border>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="设置">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="{DynamicResource ContentMaxHeight}">
          <StackPanel Margin="0,0,0,20">
            <TextBlock Text="通用" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <CheckBox Content="托盘提示显示剩余时间" IsChecked="{Binding ShowCountdown}" />
                <CheckBox Content="登录时打开" IsChecked="{Binding LoginEnabled}" ToolTip="只打开 App，不自动开始会话" />
                <CheckBox Content="结束时通知" IsChecked="{Binding NotifyOnEnd}" />
                <TextBlock Text="只提醒保持唤醒已结束，不代表 AI 任务已完成。" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
              </StackPanel>
            </Border>
            <TextBlock Text="后台组件" Style="{StaticResource SectionTitle}" Margin="2,18,0,8" />
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <DockPanel><TextBlock Text="状态" Foreground="{DynamicResource MutedBrush}" /><TextBlock Text="尚未开放" HorizontalAlignment="Right" /></DockPanel>
                <TextBlock Text="当前仅支持接电、开盖使用，应用散热保护不可用。请放在通风的桌面上。" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,10,0,0" />
              </StackPanel>
            </Border>
            <TextBlock Text="{Binding HistoryNotice}" Foreground="{DynamicResource WarningBrush}" FontSize="11" Margin="0,12,0,0" />
            <DockPanel Margin="0,18,0,0">
              <Button DockPanel.Dock="Right" Content="退出" Click="ExitClicked" ToolTip="停止保持唤醒并退出" />
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="KeepMyMacAwake" FontSize="12" FontWeight="Medium" />
                <TextBlock Text="{Binding VersionText}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,2,0,0" />
              </StackPanel>
            </DockPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" IsHitTestVisible="False" Margin="0,1,0,0">
      <Border Width="26" Height="26" Background="{DynamicResource MarkBrush}" CornerRadius="7" Margin="0,0,9,0">
        <Viewbox Margin="5"><Path Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="2" Data="M 5,12 L 23,12 L 23,21 Q 23,27 14,27 Q 5,27 5,21 Z M 23,14 L 27,14 Q 31,19 23,21 M 3,29 L 26,29 M 10,9 Q 7,6 10,3 M 17,9 Q 14,6 17,3" /></Viewbox>
      </Border>
      <TextBlock Text="KeepMyMacAwake" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
    </StackPanel>
    <Border Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0.5,0,0" Padding="0,14" x:Name="ActionBar">
      <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=Pages}" Value="1"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
      <local:PrimaryActions />
    </Border>
  </Grid>
</Window>
