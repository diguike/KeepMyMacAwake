<Application x:Class="Awake.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="PageBrush" Color="#FBF9F6" />
    <SolidColorBrush x:Key="CardBrush" Color="#F0EBE4" />
    <SolidColorBrush x:Key="TextBrush" Color="#292621" />
    <SolidColorBrush x:Key="MutedBrush" Color="#716A62" />
    <SolidColorBrush x:Key="LineBrush" Color="#DAD3C9" />
    <SolidColorBrush x:Key="AccentBrush" Color="#B55E2C" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="White" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#F5E3D5" />
    <BooleanToVisibilityConverter x:Key="BoolVisibility" />
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,9" />
      <Setter Property="Margin" Value="0,4,0,4" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Margin" Value="0,6,0,6" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Margin" Value="0,5,0,5" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Background" Value="{DynamicResource PageBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Padding" Value="20,8" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Style.Triggers>
        <!-- The native selected-tab surface uses the system control color. -->
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </Application.Resources>
</Application>
